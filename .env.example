# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=@tuempresa.com
SESSION_SECRET_KEY=changeme-to-a-random-secret

# Nautobot
NAUTOBOT_URL=https://nautobot.tuempresa.com
NAUTOBOT_TOKEN=
NAUTOBOT_DEVICE_ROLES=ACC,AGG,CORE,ROUTER,VPN

# Oxidized
OXIDIZED_MODE=api
OXIDIZED_API_URL=https://oxidized.tuempresa.com
OXIDIZED_API_TOKEN=
# OXIDIZED_GIT_REPO_PATH=/repos/oxidized  # si OXIDIZED_MODE=git

# OpenWebUI (API compatible con OpenAI)
OPENWEBUI_API_KEY=
OPENWEBUI_BASE_URL=http://openwebui.tuempresa.com/v1
OPENWEBUI_MODEL=mistral

# Cache
CACHE_TTL_REGIONS=600
CACHE_TTL_DEVICES=300

# Session
SESSION_MAX_AGE=43200
